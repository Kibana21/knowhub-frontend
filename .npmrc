# Registry-level and npm-compatible settings for knowhub-frontend.
#
# NOTE ON ENFORCEMENT. pnpm 12 reads its install policy from
# `pnpm-workspace.yaml`, not from this file: `pnpm config get frozen-lockfile`
# and `pnpm config get engine-strict` both return `undefined` under
# pnpm@12.4.2, and a bare `pnpm install` was observed to update the lockfile
# with only the keys below present. The settings that actually enforce the
# policy are therefore `frozenLockfile: true` and `engineStrict: true` in
# `pnpm-workspace.yaml`.
#
# The two keys below are retained for npm-family tooling and for any pnpm
# version that still honours the kebab-case spelling. They are a compatibility
# restatement of the policy, never its only expression.

# The committed lockfile is the single dependency-resolution path (S1 R2-R4).
frozen-lockfile=true

# The declared Node baseline in package.json engines is enforced, not
# advisory, so a contributor and CI cannot silently run different major
# runtimes (S1 R5).
engine-strict=true
